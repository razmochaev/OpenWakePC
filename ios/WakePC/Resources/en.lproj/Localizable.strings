"guide_mac_title" = "Mac Setup";
"guide_mac_subtitle" = "Menu bar agent, Wi-Fi/QR pairing & permissions";
"guide_mac_step1" = "Launch OpenWakePC Agent on your Mac — the icon appears in the top menu bar (listening on port 8765).";
"guide_mac_step2" = "On iPhone, tap 'Scan LAN for Agents' or scan the QR code shown in the agent popover — IP, MAC, and token fill in automatically.";
"guide_mac_step3" = "In the agent Settings (General tab), verify that 'Wake-on-LAN' is green. If red, click 'Fix' or enable 'Wake for network access' in macOS System Settings.";
"guide_mac_step4" = "For remote PC screen viewing, allow 'Screen Recording'; for display brightness and keyboard shortcuts, allow 'Accessibility' in macOS Privacy settings.";
"guide_mac_tip" = "Wake-on-LAN is most reliable over Ethernet (USB-C adapter). Mac laptops support Wi-Fi wake reliably while connected to power.";

"guide_wol_title" = "Windows & BIOS (Wake-on-LAN)";
"guide_wol_subtitle" = "Waking a shut-down PC over the network";
"guide_wol_step1" = "Enter BIOS/UEFI (Del or F2 at boot) and enable 'Wake on PCI-E / PME Event Up' or 'Resume by LAN'.";
"guide_wol_step2" = "Disable 'ErP Ready' (Deep S4/S5) in BIOS so the network card retains standby power when the PC is turned off.";
"guide_wol_step3" = "In Windows Device Manager -> Network Adapters -> Properties -> Power Management, enable 'Allow this device to wake the computer' and 'Only allow a magic packet'.";
"guide_wol_step4" = "In Control Panel -> Power Options -> Choose what the power buttons do, turn off 'Fast Startup' if the PC won't wake from shutdown.";
"guide_wol_step5" = "Run OpenWakePC Agent for Windows — it checks Firewall, startup registration, and displays a pairing QR code.";
"guide_wol_tip" = "After a power outage, WoL won't wake the PC until it boots once. Set 'Restore on AC Power Loss' = Power On in BIOS if needed.";

"guide_relay_title" = "Control Over Internet (E2EE)";
"guide_relay_subtitle" = "Automatic cloud relay and self-hosted VPS";
"guide_relay_step1" = "At home, iPhone communicates directly over Wi-Fi (LAN). Away from home on cellular or another Wi-Fi, commands automatically switch to the E2EE relay.";
"guide_relay_step2" = "All traffic uses end-to-end AES-256-GCM encryption derived from your token (HKDF-SHA256) — the relay server never sees commands or responses.";
"guide_relay_step3" = "Zero setup required: cloud relay works out of the box. You can also enter your own self-hosted relay URL (Docker / wakepc-relay) in Settings.";
"guide_relay_tip" = "No VPN or router port forwarding needed. Status, volume, microphone, brightness, PC screen, keyboard, timers, and custom commands all work through the relay.";

"guide_buddy_title" = "Wake Outside Home (Buddy Wake)";
"guide_buddy_subtitle" = "Waking a powered-off PC via another computer";
"guide_buddy_step1" = "Wake-on-LAN Magic Packets work only inside the home local network, so an offline PC cannot be reached directly from the internet.";
"guide_buddy_step2" = "Add a second computer in the same home network (such as an always-on Mac or PC running OpenWakePC Agent).";
"guide_buddy_step3" = "When the main PC is off and you are outside home Wi-Fi, tap the 'Wake via Another PC' banner under the power button to forward the Magic Packet locally.";
"guide_buddy_tip" = "An always-on Mac mini or home server makes an ideal Buddy Wake helper for the rest of your computers.";

"guide_controls_title" = "Audio, Screen, Touchpad & Files";
"guide_controls_subtitle" = "Managing your online computer";
"guide_controls_step1" = "Use the Volume and Microphone cards to adjust levels, mute/unmute with one tap, and switch audio output or microphone input devices.";
"guide_controls_step2" = "PC Screen opens a zoomable view of your desktop: rotate your iPhone horizontally, pinch to zoom up to 5x, or tap the image to hide controls.";
"guide_controls_step3" = "In Touchpad & Keys, drag with 1 finger to move, tap to click, scroll/right-click with 2 fingers, type text, or press hotkeys like Alt+Tab and Ctrl+C/V.";
"guide_controls_step4" = "Send to PC lets you open URLs in the PC browser, sync clipboard both ways, and upload photos or files up to 500 MB directly to Downloads on home Wi-Fi.";
"guide_controls_step5" = "Add apps, websites, or shell scripts under the Commands tab on Mac to show 1-tap action buttons right on your iPhone home screen.";
"guide_controls_tip" = "Mouse gestures and file uploads require home Wi-Fi (LAN); keyboard, hotkeys, volume, mic, custom commands, and PC screen also work over the relay.";

"guide_siri_title" = "Siri, Widgets, Timers & Geofence";
"guide_siri_subtitle" = "Quick triggers and automation";
"guide_siri_step1" = "Say 'Turn on my computer in OpenWakePC' or add any of the 10 OpenWakePC actions inside Apple Shortcuts for voice or scheduled automations.";
"guide_siri_step2" = "Add OpenWakePC widgets to your Home Screen, Lock Screen, or iOS 18 Control Center for instant 1-tap access.";
"guide_siri_step3" = "Long-press Shut Down, Restart, or Sleep to schedule a countdown timer or 'When Computer Finishes' (triggers when CPU and network stay idle).";
"guide_siri_step4" = "Enable 'Wake when arriving home' (~150 m) inside your computer profile settings to automatically send Magic Packets when you arrive.";
"guide_siri_tip" = "Active wake progress and shutdown countdowns appear on the Lock Screen and Dynamic Island via Live Activities with a quick Cancel button.";

"guide_faq_title" = "PC Won't Wake or Shows Offline";
"guide_faq_subtitle" = "Quick troubleshooting checklist";
"guide_faq_step1" = "Run 'Check Connection' at the top of this page to inspect Wi-Fi status, local subnet match, and live agent reachability.";
"guide_faq_step2" = "Make sure iPhone isn't on a guest Wi-Fi with client isolation (AP Isolation) or a VPN blocking local LAN access.";
"guide_faq_step3" = "If your computer changed its local IP after a router reboot, pull down on the main screen to refresh — the app automatically heals the IP by MAC address.";
"guide_faq_step4" = "If PC Screen fails with a permission error on Mac, open System Settings -> Privacy & Security -> Screen Recording and re-enable OpenWakePC Agent.";
"guide_faq_step5" = "On Windows, verify the network profile is set to Private in Firewall settings and disable Modern Standby / Fast Startup if Magic Packets are ignored.";
"guide_faq_tip" = "After rebuilding or updating the Mac agent, macOS may require toggling Screen Recording permission off and back on (using the '-' button and re-adding).";

